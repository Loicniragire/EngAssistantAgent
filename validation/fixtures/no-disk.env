# 002 D-101 — disk undetectable. Must not advance past lightweight on a disk
# we know nothing about, and storage must score 0 in both places.
CPU_MODEL="Synthetic 24-thread"; CPU_CORES=12; CPU_THREADS=24; CPU_VIRT=1
MEM_TOTAL_MB=65536; MEM_AVAIL_MB=60000
DISK_ROOT_CLASS=unknown; DISK_ROOT_SIZE_GB=unknown; DISK_ROOT_FREE_GB=unknown
OS_ID=ubuntu; OS_VERSION=24.04; OS_LTS=1; OS_KERNEL=6.8.0
NET_IFACES=eth0; NET_SPEED=1000
