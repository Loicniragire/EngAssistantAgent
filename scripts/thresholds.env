# Threshold data for discover.sh — generated from 002 Hardware Assessment.
#
# 004 D-201: discover.sh holds no thresholds of its own. Every value it
# compares against is defined here, and every value here is transcribed from a
# 002 table. Changing a threshold is a change to 002, then a regeneration of
# this file (scripts/stamp-thresholds.sh) — never an edit to the script.
#
# 004 D-201a: THRESHOLDS_STAMP is the sha256 of 002 §2-§6. discover.sh verifies
# it before evaluating; a mismatch is exit 30.
# validation/test-discovery.sh V-05 checks each value against 002's tables.

THRESHOLDS_SPEC="002"
THRESHOLDS_STAMP="1d9bc295eaf228306d36e6f0d4e6b8a32bbb6b3cbc3f1c1b9131f794b342f042"

# --- 002 §2.1 profile thresholds -------------------------------------------
# RAM in MiB (nominal; see MEM_TOLERANCE_PCT), cores/threads counts,
# VRAM in GiB, disk in GiB.
PROFILE_LIGHTWEIGHT_RAM_MB=8192
PROFILE_LIGHTWEIGHT_CORES=4
PROFILE_LIGHTWEIGHT_THREADS=4
PROFILE_LIGHTWEIGHT_DISK_GB=128

PROFILE_MID_RAM_MB=32768
PROFILE_MID_CORES=8
PROFILE_MID_THREADS=16
PROFILE_MID_DISK_GB=512

PROFILE_HIGH_RAM_MB=65536
PROFILE_HIGH_CORES=12
PROFILE_HIGH_THREADS=24
PROFILE_HIGH_VRAM_GB=12
PROFILE_HIGH_DISK_GB=1024

# --- 002 §2.3 reported vs. nominal memory ----------------------------------
# A memory dimension qualifies at threshold T when reported >= 95% of T.
MEM_TOLERANCE_PCT=95

# --- 002 §4.1 platform reserve (MiB) ---------------------------------------
RESERVE_LIGHTWEIGHT_MB=4096
RESERVE_MID_MB=5632

# --- 002 §4.2 per-agent working set ----------------------------------------
AGENT_RAM_MB=2048
AGENT_THREADS=2

# --- 002 §5.1 health score weights (sum to 100) ----------------------------
WEIGHT_RAM=30
WEIGHT_CPU=20
WEIGHT_STORAGE=20
WEIGHT_GPU=15
WEIGHT_SOFTWARE=10
WEIGHT_NETWORK=5

# --- 002 §5.3 bands --------------------------------------------------------
BAND_INSUFFICIENT_MAX=39
BAND_CONSTRAINED_MAX=59
BAND_CAPABLE_MAX=79

# --- 002 §3 capability matrix ----------------------------------------------
# id|name|min_cores|min_vram_gb|min_disk_gb|min_profile|needs_gpu
#
# F-14's 002 cell reads "2 threads" — a per-agent budget consumed by the §4.2
# capacity formula (AGENT_THREADS), not a matrix gate. min_cores is 0 here.
FEATURES="F-01|Host + Docker + orchestrator|2|0|20|lightweight|0
F-02|Tailscale remote access|0|0|0|lightweight|0
F-03|Encrypted backups|0|0|0|lightweight|0
F-04|PostgreSQL memory layer|1|0|20|lightweight|0
F-05|Vector store - pgvector, colocated|0|0|10|lightweight|0
F-06|Vector store - standalone|2|0|20|mid|0
F-07|Local embeddings (CPU)|2|0|5|mid|0
F-08|Local coding model - 7B @ Q4|4|6|10|mid|1
F-09|Local coding model - 14B @ Q4|4|10|20|high|1
F-10|Local coding model - 32B @ Q4|8|20|40|high|1
F-11|Monitoring - Grafana + Prometheus|2|0|50|mid|0
F-12|Scheduler - cron|0|0|0|lightweight|0
F-13|Scheduler - Temporal|2|0|20|mid|0
F-14|Concurrent agents (per agent)|0|0|10|lightweight|0"

# --- 002 §6.3 standard upgrades --------------------------------------------
# id|label|tier_rule|unlocks
UPGRADES="ram_16|RAM to 16 GB|required_below_floor|Clears the platform floor
ram_32|RAM to 32 GB|recommended_ram_8_16|mid profile; doubles agent capacity; local embeddings (F-07), standalone vector store (F-06), Temporal (F-13)
ram_64|RAM to 64 GB|optional_ram_ge_32|Little until cores increase - see 002 §4.3
cpu_16t|CPU to 16+ threads|recommended_cpu_bound|Raises the agents_cpu ceiling
disk_nvme|SATA/HDD to NVMe|recommended_rotational|Build and test throughput; mid storage threshold
gpu_12|Add GPU with 12+ GB VRAM|optional|Local coding models F-08/F-09
gpu_20|GPU to 20+ GB VRAM|optional|32B local models (F-10)
disk_1tb|Disk to 1 TB|recommended_disk_lt_512|Repo checkouts, model weights, metric retention"
