# 004 §3.3 — GPU visible to lspci with no compute runtime. Must report
# present-but-unusable and keep F-08..F-10 disabled.
CPU_MODEL="Synthetic 16-thread"; CPU_CORES=8; CPU_THREADS=16; CPU_VIRT=1
MEM_TOTAL_MB=32768; MEM_AVAIL_MB=30000
GPU_PRESENT=1; GPU_MODEL="Some Vendor Device"; GPU_VRAM_GB=unknown
GPU_DRIVER=unknown; GPU_RUNTIME=none; GPU_USABLE=0
DISK_ROOT_CLASS=nvme; DISK_ROOT_SIZE_GB=1024; DISK_ROOT_FREE_GB=800
OS_ID=ubuntu; OS_VERSION=24.04; OS_LTS=1; OS_KERNEL=6.8.0
NET_IFACES=eth0; NET_SPEED=1000
