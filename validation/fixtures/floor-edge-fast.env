# 004 §2.3 / 002 §5.3 — 4 GB RAM but 32 threads and fast NVMe. The weighted
# score alone would read as runnable; the floor check must override it.
CPU_MODEL="Synthetic 32-thread"; CPU_CORES=16; CPU_THREADS=32; CPU_VIRT=1
MEM_TOTAL_MB=4096; MEM_AVAIL_MB=3800
DISK_ROOT_CLASS=nvme; DISK_ROOT_SIZE_GB=2048; DISK_ROOT_FREE_GB=1800
OS_ID=ubuntu; OS_VERSION=24.04; OS_LTS=1; OS_KERNEL=6.8.0
NET_IFACES=eth0; NET_SPEED=10000
